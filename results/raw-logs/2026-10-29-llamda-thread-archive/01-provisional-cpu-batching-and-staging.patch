diff --git a/src/llama-moe-cache-upload.h b/src/llama-moe-cache-upload.h
new file mode 100644
index 000000000..ecb33a833
--- /dev/null
+++ b/src/llama-moe-cache-upload.h
@@ -0,0 +1,109 @@
+#pragma once
+
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+
+// Bounded pinned staging, following Project Maya's expert-transfer ring.
+class llama_moe_cache_upload {
+    struct slot {
+        ggml_backend_buffer_ptr buffer;
+        ggml_backend_event_ptr event;
+        bool pending = false;
+    };
+
+    ggml_backend_t backend;
+    std::array<slot, 2> slots;
+    size_t capacity = 0;
+    size_t next = 0;
+
+    static void wait(slot & s) {
+        if (s.pending) {
+            ggml_backend_event_synchronize(s.event.get());
+            s.pending = false;
+        }
+    }
+
+public:
+    explicit llama_moe_cache_upload(ggml_backend_t backend, size_t chunk_size = 8*1024*1024) : backend(backend) {
+        const auto dev = ggml_backend_get_device(backend);
+        if (!dev || chunk_size == 0) {
+            return;
+        }
+        ggml_backend_dev_props props;
+        ggml_backend_dev_get_props(dev, &props);
+        // UMA already shares the source memory; an extra host copy is unnecessary.
+        if (props.type != GGML_BACKEND_DEVICE_TYPE_GPU || !props.caps.async || !props.caps.host_buffer || !props.caps.events) {
+            return;
+        }
+        const auto buft = ggml_backend_dev_host_buffer_type(dev);
+        if (!buft || chunk_size > ggml_backend_buft_get_max_size(buft)) {
+            return;
+        }
+        for (auto & s : slots) {
+            s.buffer.reset(ggml_backend_buft_alloc_buffer(buft, chunk_size));
+            // Some backends silently fall back to pageable allocations.
+            if (!s.buffer || ggml_backend_buffer_get_type(s.buffer.get()) != buft) {
+                for (auto & allocated : slots) {
+                    allocated.buffer.reset();
+                    allocated.event.reset();
+                }
+                return;
+            }
+            s.event.reset(ggml_backend_event_new(dev));
+            if (!s.event) {
+                for (auto & allocated : slots) {
+                    allocated.buffer.reset();
+                    allocated.event.reset();
+                }
+                return;
+            }
+        }
+        capacity = chunk_size;
+    }
+
+    ~llama_moe_cache_upload() {
+        for (auto & s : slots) {
+            wait(s);
+        }
+    }
+
+    void set(ggml_tensor * dst, const void * data, size_t offset, size_t size) {
+        GGML_ASSERT(offset <= ggml_nbytes(dst) && size <= ggml_nbytes(dst) - offset);
+        if (!capacity) {
+            ggml_backend_tensor_set_async(backend, dst, data, offset, size);
+            return;
+        }
+        const auto * src = static_cast<const unsigned char *>(data);
+        while (size) {
+            auto & s = slots[next];
+            wait(s);
+            const size_t n = std::min(size, capacity);
+            void * staging = ggml_backend_buffer_get_base(s.buffer.get());
+            std::memcpy(staging, src, n);
+            ggml_backend_tensor_set_async(backend, dst, staging, offset, n);
+            ggml_backend_event_record(s.event.get(), backend);
+            s.pending = true;
+            next = (next + 1) % slots.size();
+            src += n;
+            offset += n;
+            size -= n;
+        }
+    }
+
+    size_t size() const {
+        size_t total = 0;
+        for (const auto & s : slots) {
+            if (s.buffer) {
+                total += ggml_backend_buffer_get_size(s.buffer.get());
+            }
+        }
+        return total;
+    }
+
+    ggml_backend_buffer_type_t buffer_type() const {
+        return capacity ? ggml_backend_buffer_get_type(slots[0].buffer.get()) : nullptr;
+    }
+};
