+// Delay copies until an event is waited on, exposing premature staging reuse.
+struct upload_test_backend {
+    struct copy { void * dst; const void * src; size_t size; };
+    struct allocation { upload_test_backend * owner; std::vector<unsigned char> bytes; };
+    ggml_backend backend = {};
+    ggml_backend_device device = {};
+    ggml_backend_buffer_type buft = {};
+    std::vector<copy> copies;
+    size_t completed = 0;
+    int allocations = 0;
+    int live = 0;
+    int fail_allocation = 0;
+    bool fail_event = false;
+    bool pageable = false;
+    bool events = true;
+    bool integrated = false;
+
+    upload_test_backend() {
+        backend.context = this;
+        backend.device = &device;
+        device.context = this;
+        buft.context = this;
+        buft.device = &device;
+        buft.iface.get_alignment = [](ggml_backend_buffer_type_t) { return size_t(32); };
+        buft.iface.alloc_buffer = [](ggml_backend_buffer_type_t bt, size_t size) -> ggml_backend_buffer_t {
+            auto & self = *static_cast<upload_test_backend *>(bt->context);
+            if (++self.allocations == self.fail_allocation) { return nullptr; }
+            if (self.pageable) { return ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), size); }
+            auto * a = new allocation{&self, std::vector<unsigned char>(size)};
+            ++self.live;
+            ggml_backend_buffer_i iface = {};
+            iface.get_base = [](ggml_backend_buffer_t b) -> void * { return static_cast<allocation *>(b->context)->bytes.data(); };
+            iface.free_buffer = [](ggml_backend_buffer_t b) {
+                auto * a = static_cast<allocation *>(b->context);
+                --a->owner->live;
+                delete a;
+            };
+            return ggml_backend_buffer_init(bt, iface, a, size);
+        };
+        device.iface.get_props = [](ggml_backend_dev_t dev, ggml_backend_dev_props * p) {
+            auto & self = *static_cast<upload_test_backend *>(dev->context);
+            *p = {};
+            p->type = self.integrated ? GGML_BACKEND_DEVICE_TYPE_IGPU : GGML_BACKEND_DEVICE_TYPE_GPU;
+            p->caps.async = true;
+            p->caps.host_buffer = true;
+            p->caps.events = self.events;
+        };
+        device.iface.get_host_buffer_type = [](ggml_backend_dev_t dev) {
+            return &static_cast<upload_test_backend *>(dev->context)->buft;
+        };
+        device.iface.event_new = [](ggml_backend_dev_t dev) -> ggml_backend_event_t {
+            if (static_cast<upload_test_backend *>(dev->context)->fail_event) { return nullptr; }
+            return new ggml_backend_event{dev, new size_t(0)};
+        };
+        device.iface.event_free = [](ggml_backend_dev_t, ggml_backend_event_t e) {
+            delete static_cast<size_t *>(e->context);
+            delete e;
+        };
+        device.iface.event_synchronize = [](ggml_backend_dev_t dev, ggml_backend_event_t e) {
+            static_cast<upload_test_backend *>(dev->context)->complete(*static_cast<size_t *>(e->context));
+        };
+        backend.iface.event_record = [](ggml_backend_t b, ggml_backend_event_t e) {
+            *static_cast<size_t *>(e->context) = static_cast<upload_test_backend *>(b->context)->copies.size();
+        };
+        backend.iface.set_tensor_async = [](ggml_backend_t b, ggml_tensor * dst, const void * data, size_t offset, size_t size) {
+            static_cast<upload_test_backend *>(b->context)->copies.push_back({static_cast<char *>(dst->data) + offset, data, size});
+        };
+    }
+
+    void complete(size_t count) {
+        while (completed < count) {
+            const auto & c = copies[completed++];
+            std::memcpy(c.dst, c.src, c.size);
+        }
+    }
+};
+
+static void test_moe_upload_staging() {
+    for (int mode = 0; mode < 7; ++mode) {
+        upload_test_backend backend;
+        backend.fail_allocation = mode == 1 ? 1 : mode == 2 ? 2 : 0;
+        backend.fail_event = mode == 3;
+        backend.pageable = mode == 4;
+        backend.events = mode != 5;
+        backend.integrated = mode == 6;
+        ggml_context_ptr ctx(ggml_init({4096, nullptr, true}));
+        auto * dst = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I8, 256);
+        ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), ggml_backend_cpu_buffer_type()));
+        ggml_backend_buffer_clear(buffer.get(), 0xee);
