+        for (size_t i = 0; i < source.size(); ++i) { source[i] = (unsigned char) i; }
+        {
+            llama_moe_cache_upload upload(&backend.backend, 16);
+            GGML_ASSERT((upload.size() != 0) == (mode == 0));
+            upload.set(dst, source.data(), 7, source.size());
+            upload.set(dst, source.data() + 3, 160, 19);
+            upload.set(dst, source.data(), 200, 0);
+        }
+        GGML_ASSERT(backend.live == 0);
+        if (mode == 0) { GGML_ASSERT(backend.completed == backend.copies.size()); }
+        backend.complete(backend.copies.size());
+        const auto * got = static_cast<unsigned char *>(dst->data);
+        for (size_t i = 0; i < 256; ++i) {
+            const unsigned char expected = i >= 7 && i < 144 ? source[i - 7] :
+                                           i >= 160 && i < 179 ? source[i - 160 + 3] : 0xee;
+            GGML_ASSERT(got[i] == expected);
+        }
+    }
